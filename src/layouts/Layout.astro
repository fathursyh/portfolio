---
import Seo, { type Props as SeoProps } from '@/components/seo.astro';
import '../styles/global.css';

interface Props extends SeoProps {}

const seoProps = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<Seo {...seoProps} />
		<script is:inline>
			(() => {
				try {
					const stored = localStorage.getItem('theme');
					const useDark = stored === 'dark';
					document.documentElement.classList.toggle('dark', useDark);
				} catch {
					document.documentElement.classList.remove('dark');
				}
			})();
		</script>
	</head>
	<body>
		<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 sm:border-x border-border pt-10 min-h-screen flex flex-col">
			<slot />
		</div>
	</body>
</html>
