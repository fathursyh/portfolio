---
import AboutExperience from '@/components/react/about-experience';
import Certificates from '@/components/certificates.astro';
import FaqSection from '@/components/react/faq';
import Footer from '@/components/react/footer';
import Hero from '@/components/react/hero';
import LatestArticles from '@/components/react/latest-articles';
import Navbar from '@/components/react/navbar';
import Testimonials from '@/components/react/testimonials';
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import type { GetImageResult } from 'astro';
import { portfolioData } from '@/data/portfolio';
import myImage from "../assets/formal-link.png";

const optimizedAva = await getImage({
  src: myImage,
  format: "avif",
  width: 150,
});

const featuredProjectImages: Record<string, GetImageResult> = Object.fromEntries(
  await Promise.all(
    portfolioData.featuredProjects.items.map(async (project) => [
      project.slug,
      await getImage({
        src: project.image.src,
        format: "avif",
        width: 512,
      }),
    ])
  )
);
---

<Layout>
	<Navbar client:idle />
	<main class="flex-1">
		<Hero client:load ava={optimizedAva} projectImages={featuredProjectImages} />
		<AboutExperience />
		<Certificates />
		<!-- <LatestArticles /> -->
		<Testimonials client:idle />
		<FaqSection client:visible />
	</main>
	<Footer />
</Layout>
