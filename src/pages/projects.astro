---
import { Image } from "astro:assets";
import Footer from "@/components/react/footer";
import Navbar from "@/components/react/navbar";
import { portfolioData, type ProjectCategory } from "@/data/portfolio";
import Layout from "@/layouts/Layout.astro";
import { withBase } from "@/lib/utils";

const { projects } = portfolioData;

const categoryAccent: Record<ProjectCategory, string> = {
  "software-engineer": "bg-rose-500",
  "project-manager": "bg-blue-500",
  cybersecurity: "bg-emerald-500",
};

const groupedCategories = projects.categories.map((category) => ({
  ...category,
  items: projects.items.filter((item) => item.category === category.id),
}));
---

<Layout
  description="Selected projects across software engineering, project management, and cybersecurity."
>
  <Navbar client:idle currentPath="/projects" />

  <main class="flex-1 py-16 sm:py-24">
    <!-- Page Header -->
    <header class="pb-10 sm:pb-12 border-b border-border/70">
      <a
        href={withBase("/")}
        class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground hover:text-foreground transition-colors rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        <span aria-hidden="true">←</span>
        Back to Home
      </a>

      <h1 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight text-foreground text-pretty">
        {projects.title}
      </h1>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground leading-relaxed text-balance">
        {projects.description}
      </p>

      <!-- Category Jump Pills -->
      <nav aria-label="Project categories" class="mt-6 flex flex-wrap gap-2">
        {
          groupedCategories.map((category) => (
            <a
              href={`#${category.id}`}
              class="inline-flex items-center gap-2 rounded-full border border-border/70 bg-muted/40 px-3 py-1.5 text-xs font-medium text-foreground hover:bg-muted transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            >
              <span
                aria-hidden="true"
                class:list={["size-1.5 rounded-full", categoryAccent[category.id]]}
              />
              <span>{category.label}</span>
              <span class="text-muted-foreground tabular-nums">
                ({category.items.length})
              </span>
            </a>
          ))
        }
      </nav>
    </header>

    <!-- Category Sections -->
    <div class="mt-12 space-y-16 sm:space-y-20">
      {
        groupedCategories.map((category) => {
          const isSingle = category.items.length === 1;

          return (
            <section
              id={category.id}
              tabindex="-1"
              class="scroll-mt-24 focus-visible:outline-none"
            >
              <div class="mb-6">
                <div class="flex items-center gap-2">
                  <span
                    aria-hidden="true"
                    class:list={["size-2 rounded-full", categoryAccent[category.id]]}
                  />
                  <h2 class="text-xl lg:text-2xl font-medium tracking-tight text-foreground">
                    {category.label}
                  </h2>
                </div>
                <p class="mt-1.5 text-sm text-muted-foreground">
                  {category.description}
                </p>
              </div>

              <div
                class:list={[
                  "grid gap-6",
                  isSingle ? "grid-cols-1" : "grid-cols-1 sm:grid-cols-2",
                ]}
              >
                {category.items.map((project) => (
                  <article
                    class:list={[
                      "group overflow-hidden rounded-xl border border-border/60 bg-muted/30 transition-colors hover:border-border",
                      isSingle
                        ? "grid grid-cols-1 sm:grid-cols-5"
                        : "flex flex-col",
                    ]}
                  >
                    <Image
                      src={project.image.src}
                      alt={project.image.alt}
                      width={640}
                      format="avif"
                      loading="lazy"
                      class:list={[
                        "w-full object-cover bg-muted",
                        isSingle
                          ? "aspect-16/10 sm:col-span-2 sm:h-full sm:aspect-auto border-b sm:border-b-0 sm:border-r border-border/50"
                          : "aspect-16/10 border-b border-border/50",
                      ]}
                    />

                    <div
                      class:list={[
                        "flex flex-1 flex-col p-4 sm:p-5",
                        isSingle && "sm:col-span-3 justify-center",
                      ]}
                    >
                      <header class="flex items-center justify-between gap-2 text-xs text-muted-foreground">
                        <span class="inline-flex items-center gap-1.5 font-medium text-foreground/80">
                          <span
                            aria-hidden="true"
                            class:list={[
                              "size-1.5 rounded-full",
                              categoryAccent[project.category],
                            ]}
                          />
                          {project.categoryLabel}
                        </span>
                        <span class="tabular-nums">{project.period}</span>
                      </header>

                      <h3 class="mt-2.5 text-base sm:text-lg font-semibold tracking-tight text-foreground text-pretty">
                        {project.title}
                      </h3>

                      <p class="mt-1.5 text-sm text-muted-foreground leading-relaxed">
                        {project.description}
                      </p>

                      <ul
                        class="mt-4 flex flex-wrap gap-1.5"
                        aria-label={`Technologies and focus areas for ${project.title}`}
                      >
                        {project.tags.map((tag) => (
                          <li class="rounded-md bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">
                            {tag}
                          </li>
                        ))}
                      </ul>

                      {(project.liveUrl || project.repoUrl) && (
                        <footer class="mt-auto pt-4 flex items-center gap-4 text-xs font-medium">
                          {project.liveUrl && (
                            <a
                              href={project.liveUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-foreground underline-offset-4 hover:underline"
                            >
                              Live Demo
                              <span class="sr-only"> for {project.title}</span>
                            </a>
                          )}
                          {project.repoUrl && (
                            <a
                              href={project.repoUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-muted-foreground hover:text-foreground underline-offset-4 hover:underline"
                            >
                              Source Code
                              <span class="sr-only"> for {project.title}</span>
                            </a>
                          )}
                        </footer>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
  </main>

  <Footer />
</Layout>
